{
  "Jwt": {
    "Issuer": "MicrofinanceErp.Api",
    "Audience": "MicrofinanceErp.Client"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Security": {
    "LockoutAttempts": 5,
    "LockoutMinutes": 15,
    "LoginRateLimit": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
